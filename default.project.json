{
  "name": "LanternExpedition",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$attributes": { "StageGameplay": true },
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "GameServer": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "GameClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "Environment": {
        "$className": "Folder"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}
