--!strict
-- Same behaviour suite is injected by CLI and Studio; no hardware input claims.
type Check = (string, unknown, unknown, number) -> ()
return function(env: any, check: Check)
	local axes: { number } = {}
	local actions: { string } = {}
	local router = env.ActionRouter.new({
		onAxis = function(axis: number)
			table.insert(axes, axis)
		end,
		onAction = function(action: string)
			table.insert(actions, action)
		end,
	})
	local function expect(name: string, expected: unknown, actual: unknown)
		check("tinput-" .. name, expected, actual, 0)
	end
	router.begin("Left", "A")
	expect("left", -1, router.inspect().axis)
	router.begin("Left", "ArrowLeft")
	router.finish("A")
	expect("alias-still-held", -1, router.inspect().axis)
	router.begin("Right", "D")
	expect("opposite-neutral", 0, router.inspect().axis)
	router.finish("ArrowLeft")
	expect("remaining-right", 1, router.inspect().axis)
	router.finish("D")
	expect("release-neutral", 0, router.inspect().axis)
	local touchLeft, touchRight = {}, {}
	router.begin("Left", touchLeft)
	router.begin("Right", touchRight)
	expect("independent-touch-neutral", 0, router.inspect().axis)
	router.finish(touchLeft)
	expect("touch-outside-release-independent", 1, router.inspect().axis)
	router.finish(touchRight)
	expect("touch-cancel-neutral", 0, router.inspect().axis)
	expect("touch-cleanup-no-holds", 0, router.inspect().heldCount)
	router.begin("Summon1", "One")
	router.begin("Summon1", "One")
	expect("repeat-once", 1, #actions)
	router.finish("One")
	router.begin("Summon1", "One")
	expect("new-press", 2, #actions)
	router.activate("Cast")
	expect("activated-once", 3, #actions)
	expect("activated-action", "Cast", actions[3])
	router.activate("Left")
	router.begin("Invalid", "bad")
	expect("invalid-no-action", 3, #actions)
	router.finish("One")
	router.begin("Left", {})
	local before = #axes
	router.step(0)
	router.step(0.099)
	expect("no-early-keepalive", before, #axes)
	router.step(0.1)
	expect("keepalive-100ms", before + 1, #axes)
	router.step(50)
	expect("no-catchup-burst", before + 2, #axes)
	router.step(50)
	expect("same-update-no-repeat", before + 2, #axes)
	router.setBlocked("text", true)
	expect("blocked-neutral", 0, axes[#axes])
	expect("blocked-clears-all", 0, router.inspect().heldCount)
	router.begin("Right", "D")
	router.activate("Cast")
	expect("blocked-action-ignored", 3, #actions)
	expect("blocked-begin-ignored", 0, router.inspect().heldCount)
	router.setBlocked("menu", true)
	router.setBlocked("text", false)
	expect("other-block-preserved", true, router.inspect().blocked)
	router.finish("D")
	router.setBlocked("menu", false)
	expect("no-reactivation", 0, router.inspect().axis)
	expect("unblocked", false, router.inspect().blocked)
	before = #axes
	router.setBlocked("focus", true)
	expect("idle-block-sends-zero", before + 1, #axes)
	router.setBlocked("focus", false)
	router.begin("Right", "D")
	router.begin("Left", "D")
	expect("token-repeat-cannot-replace", 1, router.inspect().axis)
	router.destroy()
	expect("destroy-neutral", 0, axes[#axes])
	expect("destroy-clears-held", 0, router.inspect().heldCount)
	router.begin("Left", "A")
	router.activate("Cast")
	router.step(51)
	expect("destroy-ignores-input", 0, router.inspect().axis)
	expect("destroy-ignores-action", 3, #actions)
end
