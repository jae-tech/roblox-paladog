{
  "name": "LanternExpeditionTest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "$attributes": {
        "P0TestBuild": true
      }
    },
    "ServerScriptService": {
      "GameServer": {
        "$path": "src/server"
      },
      "TestSupport": {
        "$path": "test-support",
        "Tests": {
          "$path": "tests"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "GameClient": {
          "$path": "src/client"
        },
        "TestSupport": {
          "$className": "Folder",
          "ClientHarness": {
            "$path": "test-support-client/ClientHarness.luau"
          },
          "Tests": {
            "$className": "Folder",
            "Runner": { "$path": "tests/Runner.luau" },
            "unit": {
              "$className": "Folder",
              "P5": { "$path": "tests/unit/P5.luau" },
              "P5Input": { "$path": "tests/unit/P5Input.luau" },
              "P5Net": { "$path": "tests/unit/P5Net.luau" },
              "P5View": { "$path": "tests/unit/P5View.luau" }
            }
          }
        }
      }
    },
    "Workspace": {
      "Environment": {
        "$className": "Folder"
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}
